{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Parzi default capabilities: window chrome + app events + app commands, for the shell webview only.",
  "webviews": ["main"],
  "permissions": [
    "default",
    "core:default",
    "dialog:default",
    "updater:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
